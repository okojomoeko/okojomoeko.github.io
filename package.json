{
  "name": "okojomoeko-portfolio",
  "description": "okojomoeko's astro portfolio website",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": ">=6.1.5"
    }
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "audit": "pnpm audit --audit-level=high",
    "verify": "pnpm check && pnpm lint && pnpm build && pnpm test:e2e",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/sawarabi-gothic": "^5.3.1",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
